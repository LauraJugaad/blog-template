{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "DTCG-compatible token export for AIOX Blog Template. Source of truth remains src/styles/global.css.",
  "color": {
    "foreground": {
      "$type": "color",
      "$value": "#242424",
      "$extensions": {
        "cssVariable": "--color-foreground",
        "modes": {
          "dark": "#f4f1ea"
        }
      }
    },
    "foreground-muted": {
      "$type": "color",
      "$value": "#6b6b6b",
      "$extensions": {
        "cssVariable": "--color-foreground-muted",
        "modes": {
          "dark": "#aaa39a"
        }
      }
    },
    "background": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "cssVariable": "--color-background",
        "modes": {
          "dark": "#11110f"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "cssVariable": "--color-surface",
        "modes": {
          "dark": "#181715"
        }
      }
    },
    "surface-muted": {
      "$type": "color",
      "$value": "#f9f9f9",
      "$extensions": {
        "cssVariable": "--color-surface-muted",
        "modes": {
          "dark": "#201f1c"
        }
      }
    },
    "surface-soft": {
      "$type": "color",
      "$value": "#f5f5f5",
      "$extensions": {
        "cssVariable": "--color-surface-soft",
        "modes": {
          "dark": "#292720"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "#e6e6e6",
      "$extensions": {
        "cssVariable": "--color-border",
        "modes": {
          "dark": "#3a3731"
        }
      }
    },
    "border-hairline": {
      "$type": "color",
      "$value": "#f2f2f2",
      "$extensions": {
        "cssVariable": "--color-border-hairline",
        "modes": {
          "dark": "#27251f"
        }
      }
    },
    "primary": {
      "$type": "color",
      "$value": "#242424",
      "$extensions": {
        "cssVariable": "--color-primary",
        "modes": {
          "dark": "#f4f1ea"
        }
      }
    },
    "primary-muted": {
      "$type": "color",
      "$value": "#4b5563",
      "$extensions": {
        "cssVariable": "--color-primary-muted",
        "modes": {
          "dark": "#d8d0c5"
        }
      }
    },
    "primary-contrast": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "cssVariable": "--color-primary-contrast",
        "modes": {
          "dark": "#11110f"
        }
      }
    },
    "warning": {
      "$type": "color",
      "$value": "#9a6700",
      "$extensions": {
        "cssVariable": "--color-warning",
        "modes": {
          "dark": "#f3c25f"
        }
      }
    },
    "warning-soft": {
      "$type": "color",
      "$value": "#fff7d6",
      "$extensions": {
        "cssVariable": "--color-warning-soft",
        "modes": {
          "dark": "#322818"
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "\"Source Serif 4\", Charter, Georgia, serif",
      "$extensions": {
        "cssVariable": "--font-display"
      }
    },
    "prose": {
      "$type": "fontFamily",
      "$value": "\"Source Serif 4\", Charter, Georgia, serif",
      "$extensions": {
        "cssVariable": "--font-prose"
      }
    },
    "ui": {
      "$type": "fontFamily",
      "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "$extensions": {
        "cssVariable": "--font-ui"
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      "$extensions": {
        "cssVariable": "--font-mono"
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$extensions": {
        "cssVariable": "--rounded-sm"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "0.5rem",
      "$extensions": {
        "cssVariable": "--rounded-md"
      }
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px",
      "$extensions": {
        "cssVariable": "--rounded-pill"
      }
    }
  },
  "layout": {
    "reading-column": {
      "$type": "dimension",
      "$value": "45rem",
      "$extensions": {
        "cssVariable": "--reading-column"
      }
    },
    "max": {
      "$type": "dimension",
      "$value": "72rem",
      "$extensions": {
        "cssVariable": "--layout-max"
      }
    }
  }
}

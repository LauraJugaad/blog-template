# build outputs
dist/
.astro/
.wrangler/

# dependencies
node_modules/

# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# local agent/session captures — never ship into template forks
.synapse/
20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# os
.DS_Store
Thumbs.db

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# cloudflare — never commit these (contain account_id, database_id, routes,
# secrets, and per-instance tenant config). Each fork generates its own from
# the .example template via `cp wrangler.toml.example wrangler.toml`.
.dev.vars
.dev.vars.*
wrangler.toml
.wrangler/
worker-configuration-local.d.ts

# package-lock from npm runs (workspace is Bun-only — root bun.lock is the SOT)
package-lock.json
yarn.lock
pnpm-lock.yaml

# generated D1 dumps (export D1 → MDX backups go elsewhere; never commit local DB state)
*.sqlite
*.sqlite3
*.db

# claude code
.claude/settings.local.json

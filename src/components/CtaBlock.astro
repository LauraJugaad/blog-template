---
/**
 * CtaBlock — bloco de call-to-action reusável.
 * Usado no template do artigo logo após o KeyTakeaways (variant="soft")
 * para cumprir o padrão GEO/AEO de ter um CTA visível pré-corpo sem
 * tirar o foco da leitura.
 *
 * CTAs distribuídos dentro do corpo do artigo NÃO usam este componente —
 * eles vêm como HTML inline (`<aside class="cta-inline">`) no próprio
 * `articles.content`, via skill de geração.
 */

interface Props {
  variant?: 'soft' | 'strong';
  headline: string;
  body: string;
  href: string;
  label: string;
}

const { variant = 'soft', headline, body, href, label } = Astro.props;

const containerClass =
  variant === 'strong'
    ? 'my-10 rounded-md bg-foreground p-7 text-background'
    : 'my-10 rounded-md border-l-4 border-primary bg-surface-muted p-6';

const headlineClass =
  variant === 'strong'
    ? 'mb-2 mt-0 font-prose text-2xl font-bold leading-tight text-background'
    : 'mb-2 mt-0 font-prose text-2xl font-bold leading-tight text-foreground';

const bodyClass = variant === 'strong' ? 'mb-5 leading-7 text-background' : 'mb-5 leading-7 text-muted';

const buttonClass =
  variant === 'strong'
    ? 'inline-flex h-10 items-center rounded-full bg-background px-5 text-sm font-semibold text-foreground no-underline hover:bg-surface-soft hover:no-underline'
    : 'inline-flex h-10 items-center rounded-full bg-foreground px-5 text-sm font-semibold text-background no-underline hover:bg-primary-muted hover:no-underline';
---

<aside class={containerClass} role="complementary">
  <h3 class={headlineClass}>{headline}</h3>
  <p class={bodyClass}>{body}</p>
  <a href={href} class={buttonClass}>{label}</a>
</aside>

---
/**
 * FaqBlock — Perguntas frequentes. Renderiza usando <details>/<summary>
 * (semântica nativa, sem JS) e a ordem importa: o RAG gosta de FAQ perto do
 * final do documento. O schema FAQPage é emitido em paralelo via structured-data.
 */

import type { FaqItem } from '~/db/schema';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

{items && items.length > 0 && (
  <section aria-labelledby="faq-h" class="my-12 border-t border-border-hairline pt-8">
    <h2 id="faq-h" class="mb-5 font-prose text-3xl font-bold leading-tight tracking-normal text-foreground">
      Perguntas frequentes
    </h2>
    <div class="divide-y divide-border-hairline border-y border-border-hairline">
      {items.map((item) => (
        <details
          class="group bg-background open:bg-surface-muted"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-1 py-4 font-medium text-foreground">
            <span>{item.q}</span>
            <span
              aria-hidden="true"
              class="text-muted transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <div class="px-1 pb-4 leading-7 text-muted" set:html={item.a} />
        </details>
      ))}
    </div>
  </section>
)}

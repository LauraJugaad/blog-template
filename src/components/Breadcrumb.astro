---
interface Item {
  name: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6 font-ui text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((item, idx) => (
        <li class="flex items-center gap-2">
          {idx > 0 && <span aria-hidden="true" class="text-border">›</span>}
          {item.href ? (
            <a href={item.href} class="no-underline hover:text-foreground hover:no-underline">{item.name}</a>
          ) : (
            <span aria-current="page" class="text-foreground">
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

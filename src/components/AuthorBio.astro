---
/**
 * AuthorBio — bloco de autoridade no rodapé do artigo.
 * Renderiza avatar, nome, cargo, bio, credenciais e redes sociais.
 * Só deve ser montado pelo template quando o artigo é assinado pelo autor
 * default (para evitar mostrar bio errada de um autor custom sem dados).
 *
 * Todos os dados vêm das vars do wrangler.toml (DEFAULT_AUTHOR_*) via
 * getSiteConfig() — zero dependência do schema do D1.
 */

interface Props {
  name: string;
  url?: string;
  jobTitle?: string;
  bio: string;
  avatarUrl?: string;
  credentials?: string[];
  sameAs?: string[];
}

const { name, url, jobTitle, bio, avatarUrl, credentials = [], sameAs = [] } = Astro.props;
// v2 (2026-05-10): sempre reservar coluna do avatar (com fallback de iniciais Forest Green)
// pra garantir hierarquia visual consistente sem botão "Seguir" órfão.
const containerClass = 'grid gap-5 sm:grid-cols-[4rem_1fr] sm:items-start';

// Iniciais do nome pra fallback do avatar
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .map((n) => n[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

// Detecta tipo de rede social pelo host para escolher rótulo acessível.
function socialLabel(href: string): string {
  try {
    const host = new URL(href).hostname.replace(/^www\./, '');
    if (host.includes('linkedin')) return 'LinkedIn';
    if (host === 'x.com' || host.includes('twitter')) return 'X';
    if (host.includes('github')) return 'GitHub';
    if (host.includes('instagram')) return 'Instagram';
    if (host.includes('youtube')) return 'YouTube';
    return host;
  } catch {
    return 'Link';
  }
}
---

<section
  class="mt-12 border-y border-border-hairline py-8"
  aria-labelledby="sobre-o-autor-h"
  itemscope
  itemtype="https://schema.org/Person"
>
  <div class={containerClass}>
    {avatarUrl ? (
      <img
        src={avatarUrl}
        alt={name}
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
        class="h-16 w-16 rounded-full border border-border object-cover"
        itemprop="image"
      />
    ) : (
      <div
        aria-hidden="true"
        class="flex h-16 w-16 items-center justify-center rounded-full bg-primary text-2xl font-bold text-primary-contrast"
      >
        {initials}
      </div>
    )}
    <div class="flex-1 min-w-0">
      <h2 id="sobre-o-autor-h" class="m-0 font-prose text-2xl font-bold leading-tight text-foreground">
        Sobre o autor
      </h2>
      <p class="mb-1 mt-2 text-xl font-bold text-foreground">
        {url ? (
          <a href={url} itemprop="url" class="no-underline hover:underline">
            <span itemprop="name">{name}</span>
          </a>
        ) : (
          <span itemprop="name">{name}</span>
        )}
      </p>
      {jobTitle && (
        <p class="mb-3 mt-0 text-sm font-normal text-muted" itemprop="jobTitle">{jobTitle}</p>
      )}
      {bio && (
        <p class="my-2 leading-7 text-muted" itemprop="description">{bio}</p>
      )}
      {credentials.length > 0 && (
        <ul class="mt-3 space-y-1 pl-0 list-none">
          {credentials.map((c) => (
            <li class="relative pl-5 text-sm text-muted before:absolute before:left-0 before:font-bold before:text-primary before:content-['✓']">
              {c}
            </li>
          ))}
        </ul>
      )}
      {sameAs.length > 0 && (
        <p class="mt-4 flex flex-wrap gap-3 text-sm">
          {sameAs.map((href) => (
            <a
              href={href}
              rel="me noopener"
              target="_blank"
              itemprop="sameAs"
              class="text-primary hover:underline"
            >
              {socialLabel(href)}
            </a>
          ))}
        </p>
      )}
    </div>
  </div>
</section>

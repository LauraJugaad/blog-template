---
/**
 * KeyTakeaways — "Principais conclusões". Bloco destacado acima do conteúdo
 * do artigo. É o primeiro chunk que o retriever do RAG costuma pegar, então
 * é intencional que ele: (a) venha logo depois do H1, (b) seja auto-contido,
 * (c) use verbos imperativos, (d) contenha a marca no último bullet.
 */

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{items && items.length > 0 && (
  <section
    aria-labelledby="principais-conclusoes-h"
    class="key-takeaways my-8 border-y border-border-hairline bg-surface py-6"
  >
    <h2
      id="principais-conclusoes-h"
      class="!mb-4 !mt-0 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-primary"
    >
      Principais conclusões
    </h2>
    <ol class="mt-3 space-y-3">
      {items.map((item, index) => (
        <li class="grid grid-cols-[2rem_1fr] gap-3 text-[0.98rem] leading-7 text-foreground">
          <span class="font-mono text-xs font-semibold text-primary">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span set:html={item} />
        </li>
      ))}
    </ol>
  </section>
)}

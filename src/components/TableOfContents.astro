---
/**
 * TableOfContents — extrai H2s do HTML do artigo e monta um sumário navegável.
 * Adiciona id aos H2s que não tenham, preservando o HTML original.
 *
 * Devolve duas coisas via `Astro.props.onContent`? Não — Astro não tem esse
 * callback. Em vez disso, expomos uma função utilitária que o [slug].astro
 * usa para derivar o HTML decorado E a lista de seções em uma única passada.
 */

interface TocItem {
  id: string;
  text: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{items && items.length >= 3 && (
  <nav id="toc" aria-label="Sumário do artigo" class="my-6 border-y border-border-hairline py-5 lg:my-0 lg:border-y-0 lg:border-l lg:pl-5">
    <p class="mb-3 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-primary">
      Neste artigo
    </p>
    <ol class="space-y-2 text-sm">
      {items.map((item, index) => (
        <li class="grid grid-cols-[1.75rem_1fr] gap-2">
          <span class="font-mono text-[0.68rem] font-semibold text-muted">
            {String(index + 1).padStart(2, '0')}
          </span>
          <a href={`#${item.id}`} class="leading-5 text-muted no-underline hover:text-foreground hover:no-underline">
            {item.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

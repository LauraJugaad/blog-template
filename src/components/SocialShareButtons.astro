---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const links = [
  {
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    label: 'Compartilhar no LinkedIn',
  },
  {
    name: 'X',
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    label: 'Compartilhar no X',
  },
  {
    name: 'WhatsApp',
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    label: 'Compartilhar no WhatsApp',
  },
  {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    label: 'Compartilhar no Facebook',
  },
  {
    name: 'E-mail',
    href: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
    label: 'Compartilhar por e-mail',
  },
];
---

<aside
  aria-label="Compartilhar artigo nas redes sociais"
  class="mt-8 border-y border-border-hairline py-5 sm:mt-10"
>
  <p class="mb-3 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-primary">
    Compartilhe este artigo
  </p>
  <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
    {links.map((link) => (
      <a
        href={link.href}
        target={link.name === 'E-mail' ? undefined : '_blank'}
        rel={link.name === 'E-mail' ? undefined : 'noopener noreferrer'}
        aria-label={link.label}
        class="text-muted no-underline hover:text-primary hover:underline"
      >
        {link.name}
      </a>
    ))}
  </div>
</aside>

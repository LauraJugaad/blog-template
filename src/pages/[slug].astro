---
import Base from '~/layouts/Base.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import AiShareButtons from '~/components/AiShareButtons.astro';
import KeyTakeaways from '~/components/KeyTakeaways.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import TableOfContents from '~/components/TableOfContents.astro';
import CtaBlock from '~/components/CtaBlock.astro';
import AuthorBio from '~/components/AuthorBio.astro';
import SocialShareButtons from '~/components/SocialShareButtons.astro';
import { createDb } from '~/db/client';
import { articles, authors, categories } from '~/db/schema';
import { and, desc, eq, ne } from 'drizzle-orm';
import { getSiteConfig } from '~/lib/site';
import {
  articleJsonLd,
  breadcrumbJsonLd,
  faqPageJsonLd,
  howToJsonLd,
  computeReadingTime,
} from '~/lib/structured-data';
import { formatDate } from '~/lib/format';
import { url } from '~/lib/paths';
import { buildTocAndDecorate } from '~/lib/toc';
import { isReservedSlug } from '~/lib/slug';
import { authorHref, resolveArticleAuthor } from '~/lib/authors';
import { env } from '~/lib/runtime-env';

export const prerender = false;

const site = getSiteConfig(env);
const db = createDb(env.DB);

const slug = Astro.params.slug;
if (!slug || isReservedSlug(slug, env.INDEXNOW_KEY)) {
  return new Response('Not Found', { status: 404 });
}

const rows = await db
  .select()
  .from(articles)
  .where(and(eq(articles.slug, slug), eq(articles.status, 'published')))
  .limit(1);

if (rows.length === 0) {
  return new Response('Not Found', { status: 404 });
}
const article = rows[0]!;

// Pull category display name and related articles in parallel.
const authorLookup = article.author_slug
  ? db.select().from(authors).where(eq(authors.slug, article.author_slug)).limit(1)
  : db.select().from(authors).where(eq(authors.name, article.author_name)).limit(1);

const [categoryRows, related, authorRows] = await Promise.all([
  article.category
    ? db
        .select()
        .from(categories)
        .where(eq(categories.slug, article.category))
        .limit(1)
    : Promise.resolve([]),
  article.category
    ? db
        .select({
          slug: articles.slug,
          title: articles.title,
          summary: articles.summary,
        })
        .from(articles)
        .where(
          and(
            eq(articles.status, 'published'),
            eq(articles.category, article.category),
            ne(articles.id, article.id),
          ),
        )
        .orderBy(desc(articles.published_at))
        .limit(5)
    : Promise.resolve([]),
  authorLookup,
]);
const category = categoryRows[0];
const articleAuthor = resolveArticleAuthor(article, authorRows[0], site);
const articleAuthorHref = authorHref(articleAuthor);

const canonicalUrl = `${site.siteUrl}/${article.slug}`;
const tags = Array.isArray(article.tags) ? article.tags : [];
const keyTakeaways = Array.isArray(article.key_takeaways) ? article.key_takeaways : [];
const faqItems = Array.isArray(article.faq) ? article.faq : [];
const heroImage = article.hero_image_url?.trim() || undefined;
const readingTime = article.reading_time_min ?? computeReadingTime(article.content, site.siteLang);

// Decorate content HTML: inject ids into H2s and extract TOC.
const { html: decoratedHtml, toc } = buildTocAndDecorate(article.content);

// Breadcrumb visual usa rotas relativas (url() helper); JSON-LD usa absolutas
// para schema.org compliance.
const breadcrumbItems = [
  { name: 'Início', href: url('/'), absoluteUrl: site.siteUrl },
  ...(category
    ? [{
        name: category.name,
        href: url(`/categoria/${category.slug}`),
        absoluteUrl: `${site.siteUrl}/categoria/${category.slug}`,
      }]
    : []),
  { name: article.title, absoluteUrl: canonicalUrl },
];

const jsonLdNodes: Record<string, unknown>[] = [
  articleJsonLd(article, site, category?.name, articleAuthor),
  breadcrumbJsonLd(
    breadcrumbItems.map((item) => ({ name: item.name, url: item.absoluteUrl })),
  ),
];
if (faqItems.length > 0) {
  jsonLdNodes.push(faqPageJsonLd(faqItems));
}
const howToNode = howToJsonLd(article, site);
if (howToNode) {
  jsonLdNodes.push(howToNode);
}

const showAuthorBio = Boolean(
  articleAuthor.bio || articleAuthor.avatarUrl,
);
---

<Base
  title={article.meta_title ?? article.title}
  description={article.meta_description ?? article.summary}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={heroImage}
  publishedTime={article.published_at ?? undefined}
  modifiedTime={article.updated_at}
  jsonLd={jsonLdNodes}
  articleSection={category?.name}
  articleTags={tags}
  articleAuthor={articleAuthor.name}
>
  <article class="mx-auto max-w-[var(--layout-max)] px-4 py-8 sm:px-6 sm:py-12">
    <div class="lg:grid lg:grid-cols-[minmax(0,var(--reading-column))_16rem] lg:items-start lg:gap-12">
      <div class="min-w-0">
        <Breadcrumb
          items={breadcrumbItems.map((b) => ({ name: b.name, href: b.href }))}
        />

        <header class="mb-6 sm:mb-8">
          {category && (
            <a
              href={url(`/categoria/${category.slug}`)}
              class="mb-3 inline-flex rounded-full bg-surface-muted px-3 py-1 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-primary no-underline hover:bg-primary-soft hover:no-underline sm:mb-4"
            >
              {category.name}
            </a>
          )}

          <h1 class="mb-5 font-display text-[2.35rem] font-bold leading-[1.08] tracking-normal text-foreground sm:mb-6 sm:text-5xl md:text-6xl">
            {article.title}
          </h1>

          {/* Summary block: primeiro chunk citável por AI Overviews.
              A classe `summary-speakable` é alvo do SpeakableSpecification
              emitido em Article JSON-LD. v2 (2026-05-10): card de "blindagem"
              Sage+Caregiver — bg-surface-muted suave + border-l grossa Forest Green. */}
          <p class="summary-speakable my-5 rounded-r-md border-l-4 border-primary bg-surface-muted/60 py-4 pl-5 pr-4 font-prose text-lg font-normal leading-[1.65] text-foreground sm:my-6 sm:py-5 sm:pl-6 sm:text-[1.25rem] sm:leading-[1.6]">
            {article.summary}
          </p>

          <div class="flex flex-wrap gap-x-3 gap-y-1 text-[0.92rem] text-muted sm:gap-x-4 sm:text-sm">
            <span>
              Por{' '}
              {articleAuthorHref ? (
                <a href={articleAuthorHref} rel="author" class="font-medium text-foreground no-underline hover:no-underline">
                  {articleAuthor.name}
                </a>
              ) : (
                <span class="font-medium text-foreground">{articleAuthor.name}</span>
              )}
            </span>
            {article.published_at && (
              <span>
                Publicado em{' '}
                <time datetime={article.published_at}>
                  {formatDate(article.published_at, site.siteLang)}
                </time>
              </span>
            )}
            {readingTime > 0 && (
              <span aria-label="Tempo estimado de leitura">{readingTime} min de leitura</span>
            )}
            {article.updated_at && article.updated_at !== article.published_at && (
              <span>
                Atualizado em{' '}
                <time datetime={article.updated_at}>
                  {formatDate(article.updated_at, site.siteLang)}
                </time>
              </span>
            )}
          </div>
        </header>

        <div id="ai-share">
          <AiShareButtons url={canonicalUrl} brand={site.org.name} />
        </div>

        {heroImage && (
          <figure class="my-6 overflow-hidden rounded-md border border-border-hairline bg-surface-muted sm:my-8">
            <img
              src={heroImage}
              alt={article.title}
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
              class="aspect-[16/9] w-full object-cover"
            />
          </figure>
        )}

        {keyTakeaways.length > 0 && <KeyTakeaways items={keyTakeaways} />}

        {toc.length >= 3 && (
          <div class="lg:hidden">
            <TableOfContents items={toc} />
          </div>
        )}

        <div class="content max-w-[var(--reading-column)]" set:html={decoratedHtml} />

        <div class="mx-auto max-w-[var(--reading-column)]">
          {tags.length > 0 && (
            <div class="mt-10 flex flex-wrap gap-2" aria-label="Tópicos">
              {tags.map((tag) => (
                <span class="inline-block rounded-full bg-surface-muted px-3 py-1 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-muted">
                  #{tag}
                </span>
              ))}
            </div>
          )}

          {faqItems.length > 0 && <FaqBlock items={faqItems} />}

          {showAuthorBio && (
            <AuthorBio
              name={articleAuthor.name}
              url={articleAuthorHref}
              jobTitle={articleAuthor.jobTitle}
              bio={articleAuthor.bio}
              avatarUrl={articleAuthor.avatarUrl}
              credentials={articleAuthor.credentials}
              sameAs={articleAuthor.sameAs}
            />
          )}

          {related.length > 0 && (
            <aside class="mt-12 border-t border-border-hairline pt-8">
              <h2 class="mb-5 font-prose text-2xl font-bold leading-tight text-foreground sm:text-3xl">
                Artigos relacionados
              </h2>
              <ul class="space-y-5">
                {related.map((r) => (
                  <li>
                    <a href={url(`/${r.slug}`)} class="font-prose text-xl font-bold leading-tight text-foreground no-underline hover:text-primary-muted hover:no-underline">
                      {r.title}
                    </a>
                    <p class="mt-2 text-sm leading-6 text-muted">{r.summary}</p>
                  </li>
                ))}
              </ul>
            </aside>
          )}

          <CtaBlock
            variant="strong"
            headline="Quer instalar solar na sua casa sem cair em orçamento inflado?"
            body={`A ${site.org.name} atende Campinas e Jundiaí — engenheira eletricista, 174 instalações entregues, método de blindagem do consumidor.`}
            href={site.org.url}
            label={`Conhecer a ${site.org.name}`}
          />

          <SocialShareButtons url={canonicalUrl} title={article.title} />
        </div>
      </div>

      {toc.length >= 3 && (
        <aside class="sticky top-24 hidden lg:block">
          <TableOfContents items={toc} />
        </aside>
      )}
    </div>
  </article>
</Base>

---
import Base from '~/layouts/Base.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import ArticleCard from '~/components/ArticleCard.astro';
import CategoryTabs from '~/components/CategoryTabs.astro';
import Pagination from '~/components/Pagination.astro';
import { createDb } from '~/db/client';
import { articles, authors, categories } from '~/db/schema';
import { and, asc, desc, eq, sql } from 'drizzle-orm';
import { getSiteConfig } from '~/lib/site';
import { breadcrumbJsonLd } from '~/lib/structured-data';
import { url } from '~/lib/paths';
import { parsePage, parsePageSize } from '~/lib/pagination';
import { resolveArticleAuthor } from '~/lib/authors';
import { env } from '~/lib/runtime-env';

export const prerender = false;

const site = getSiteConfig(env);
const db = createDb(env.DB);

const slug = Astro.params.slug;
if (!slug) return new Response('Not Found', { status: 404 });

const catRows = await db
  .select()
  .from(categories)
  .where(eq(categories.slug, slug))
  .limit(1);

if (catRows.length === 0) return new Response('Not Found', { status: 404 });
const category = catRows[0]!;

const limit = parsePageSize(Astro.url.searchParams.get('limit'));
const page = parsePage(Astro.url.searchParams.get('page'));
const offset = (page - 1) * limit;
const where = and(eq(articles.status, 'published'), eq(articles.category, slug));

const [items, totalRow, authorRows, categoryRows] = await Promise.all([
  db
    .select({
      slug: articles.slug,
      title: articles.title,
      summary: articles.summary,
      category: articles.category,
      published_at: articles.published_at,
      author_slug: articles.author_slug,
      author_name: articles.author_name,
      hero_image_url: articles.hero_image_url,
      reading_time_min: articles.reading_time_min,
    })
    .from(articles)
    .where(where)
    .orderBy(desc(articles.published_at))
    .limit(limit)
    .offset(offset),
  db.select({ count: sql<number>`count(*)` }).from(articles).where(where),
  db.select().from(authors).where(eq(authors.status, 'active')),
  db
    .select({
      slug: categories.slug,
      name: categories.name,
    })
    .from(categories)
    .orderBy(asc(categories.name))
    .limit(6),
]);
const authorRowsBySlug = new Map(authorRows.map((author) => [author.slug, author]));
const authorFor = (article: (typeof items)[number]) =>
  resolveArticleAuthor(
    article,
    article.author_slug ? authorRowsBySlug.get(article.author_slug) : null,
    site,
  );
const total = totalRow[0]?.count ?? 0;

const canonicalUrl = `${site.siteUrl}/categoria/${category.slug}`;

// Breadcrumb visual usa rotas relativas (url() helper), JSON-LD usa absolutas
// para schema.org compliance.
const breadcrumbItems = [
  { name: 'Início', href: url('/'), absoluteUrl: site.siteUrl },
  { name: category.name, absoluteUrl: canonicalUrl },
];

const jsonLd = breadcrumbJsonLd(
  breadcrumbItems.map((item) => ({ name: item.name, url: item.absoluteUrl })),
);
---

<Base
  title={`${category.name} — ${site.siteName}`}
  description={category.description ?? `Artigos sobre ${category.name}`}
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-[var(--reading-column)] px-4 py-8 sm:px-6 sm:py-12">
    <Breadcrumb items={breadcrumbItems.map((b) => ({ name: b.name, href: b.href }))} />

    <header class="mb-8">
      <p class="mb-3 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-primary">
        Categoria
      </p>
      <h1 class="mb-3 font-display text-[2.35rem] font-bold leading-[1.05] tracking-normal text-foreground sm:text-5xl">
        {category.name}
      </h1>
      {category.description && <p class="max-w-xl text-lg leading-8 text-muted">{category.description}</p>}
    </header>

    <CategoryTabs categories={categoryRows} activeSlug={category.slug} />

    {items.length === 0 ? (
      <p class="py-10 text-muted">Nenhum artigo nesta categoria ainda.</p>
    ) : (
      <div>
        {items.map((article) => <ArticleCard article={article} author={authorFor(article)} />)}
      </div>
    )}

    <Pagination
      page={page}
      total={total}
      limit={limit}
      basePath={url(`/categoria/${category.slug}`)}
    />
  </section>
</Base>

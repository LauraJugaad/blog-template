---
import Base from '~/layouts/Base.astro';
import { getSiteConfig } from '~/lib/site';
import { url } from '~/lib/paths';
import { env } from '~/lib/runtime-env';

export const prerender = false;

const site = getSiteConfig(env);
---

<Base
  title={`Página não encontrada — ${site.siteName}`}
  description="O conteúdo que você procurou não foi encontrado."
  noindex
>
  <section class="mx-auto max-w-[var(--reading-column)] px-4 py-20 text-center">
    <h1 class="mb-3 font-display text-5xl font-bold leading-none text-foreground">404</h1>
    <p class="mb-6 text-muted">A página que você procura não existe ou foi removida.</p>
    <a href={url('/')} class="font-medium text-primary">← Voltar para o início</a>
  </section>
</Base>

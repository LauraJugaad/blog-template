---
import '../styles/global.css';
import SearchIsland from '~/components/SearchIsland.tsx';
import { env } from '~/lib/runtime-env';
import { getSiteConfig } from '~/lib/site';
import { organizationJsonLd, websiteJsonLd } from '~/lib/structured-data';
import { url } from '~/lib/paths';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  articleSection?: string;
  articleTags?: string[];
  articleAuthor?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
  articleSection,
  articleTags,
  articleAuthor,
} = Astro.props;

const site = getSiteConfig(env);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.siteUrl).toString();

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const effectiveOgImage = ogImage;

// Site-wide JSON-LD: Organization + WebSite (with SearchAction).
const baseJsonLd = [organizationJsonLd(site.org), websiteJsonLd(site)];
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [...baseJsonLd, ...pageJsonLd];
---

<!doctype html>
<html lang={site.siteLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        const key = 'aiox-blog-template-theme';
        const root = document.documentElement;

        try {
          const stored = localStorage.getItem(key);
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';

          root.dataset.theme = theme;
          root.style.colorScheme = theme;
        } catch {
          root.dataset.theme = 'light';
          root.style.colorScheme = 'light';
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robotsContent} />
    {articleTags && articleTags.length > 0 && (
      <meta name="keywords" content={articleTags.join(', ')} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={site.siteLang.replace('-', '_')} />
    <meta property="og:site_name" content={site.siteName} />
    {effectiveOgImage && <meta property="og:image" content={effectiveOgImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleTags && articleTags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content={effectiveOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {effectiveOgImage && <meta name="twitter:image" content={effectiveOgImage} />}

    <link rel="sitemap" href={url('/sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.siteName} href={url('/feed.xml')} />

    <!-- JSON-LD structured data -->
    {
      allJsonLd.map((data) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(data)}
        />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground">
    <a href="#main-content" class="skip-link">Pular para o conteúdo</a>

    <header class="sticky top-0 z-50 border-b border-border-hairline bg-background">
      <div class="mx-auto flex h-14 max-w-[var(--layout-max)] items-center gap-3 px-4 sm:h-16 sm:px-6 md:gap-5">
        <a
          href={url('/')}
          class="min-w-0 max-w-[6.5rem] truncate font-display text-xl font-bold leading-none text-foreground no-underline hover:no-underline sm:max-w-none sm:text-2xl"
          aria-label={`${site.siteName} — início`}
        >
          {site.siteName}
        </a>

        <div class="hidden w-full max-w-sm md:block">
          <SearchIsland client:load />
        </div>

        <div class="flex-1"></div>

        <nav aria-label="Principal" class="text-sm">
          <ul class="flex items-center gap-0 sm:gap-4">
            <li class="hidden sm:block">
              <a href={url('/')} class="text-muted no-underline hover:text-foreground hover:no-underline">
                Início
              </a>
            </li>
            <li>
              <button
                type="button"
                class="theme-toggle"
                data-theme-toggle
                aria-label="Alternar para tema escuro"
                title="Alternar tema"
              >
                <svg
                  class="theme-icon-moon"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 3a6 6 0 0 0 9 7.5A9 9 0 1 1 12 3Z" />
                </svg>
                <svg
                  class="theme-icon-sun"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="4" />
                  <path d="M12 2v2" />
                  <path d="M12 20v2" />
                  <path d="m4.93 4.93 1.41 1.41" />
                  <path d="m17.66 17.66 1.41 1.41" />
                  <path d="M2 12h2" />
                  <path d="M20 12h2" />
                  <path d="m6.34 17.66-1.41 1.41" />
                  <path d="m19.07 4.93-1.41 1.41" />
                </svg>
              </button>
            </li>
            <li>
              <a
                href={url('/llms.txt')}
                class="inline-flex h-11 w-11 items-center justify-center rounded-full text-muted no-underline hover:bg-surface-muted hover:text-foreground hover:no-underline"
                aria-label="Abrir llms.txt"
                title="llms.txt"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 19.5V4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5Z" />
                  <path d="M8 7h8" />
                  <path d="M8 11h8" />
                  <path d="M8 15h5" />
                </svg>
              </a>
            </li>
            <li>
              <a
                href={site.org.url}
                class="inline-flex min-h-11 items-center rounded-full bg-foreground px-4 text-sm font-medium text-background no-underline hover:bg-primary-muted hover:no-underline"
              >
                {site.org.name}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-border-hairline bg-surface-muted">
      <div class="mx-auto grid max-w-[var(--layout-max)] gap-8 px-4 py-10 text-sm text-muted sm:px-6 md:grid-cols-[1.2fr_1fr_1fr_1fr]">
        <div>
          <p class="mb-2 font-display text-2xl font-bold text-foreground">{site.siteName}</p>
          <p class="max-w-sm leading-6">{site.siteDescription}</p>
        </div>
        <nav aria-label="Explorar" class="space-y-2">
          <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-foreground">
            Explorar
          </p>
          <a href={url('/')} class="block no-underline hover:text-foreground hover:no-underline">Início</a>
          <a href={url('/sitemap.xml')} class="block no-underline hover:text-foreground hover:no-underline">Sitemap</a>
          <a href={url('/llms.txt')} class="block no-underline hover:text-foreground hover:no-underline">llms.txt</a>
        </nav>
        <nav aria-label="AIOX" class="space-y-2">
          <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-foreground">
            AIOX
          </p>
          <a href={site.org.url} class="block no-underline hover:text-foreground hover:no-underline">
            Repositório oficial
          </a>
          {site.org.sameAs.map((href) => (
            <a href={href} class="block no-underline hover:text-foreground hover:no-underline">
              {new URL(href).hostname.replace(/^www\./, '')}
            </a>
          ))}
        </nav>
        <div class="space-y-2">
          <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-foreground">
            Atualizações
          </p>
          <a
            href={site.org.url}
            class="inline-flex min-h-10 items-center rounded-full bg-foreground px-4 py-2 font-medium text-background no-underline hover:bg-primary-muted hover:no-underline"
          >
            Ver {site.org.name}
          </a>
          <p>&copy; {new Date().getFullYear()} {site.siteName}</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const key = 'aiox-blog-template-theme';
        const root = document.documentElement;
        const toggle = document.querySelector('[data-theme-toggle]');
        const media = window.matchMedia('(prefers-color-scheme: dark)');

        const storedTheme = () => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        };

        const updateButton = (theme) => {
          if (!toggle) return;
          const next = theme === 'dark' ? 'claro' : 'escuro';
          toggle.setAttribute('aria-label', `Alternar para tema ${next}`);
          toggle.setAttribute('title', `Alternar para tema ${next}`);
        };

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          updateButton(theme);
        };

        const currentTheme = () =>
          root.dataset.theme === 'dark' || root.dataset.theme === 'light'
            ? root.dataset.theme
            : media.matches
              ? 'dark'
              : 'light';

        applyTheme(currentTheme());

        toggle?.addEventListener('click', () => {
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(key, next);
          } catch {
            // Persistência indisponível; a troca ainda vale para a sessão atual.
          }
          applyTheme(next);
        });

        media.addEventListener('change', (event) => {
          if (storedTheme()) return;
          applyTheme(event.matches ? 'dark' : 'light');
        });
      })();
    </script>
  </body>
</html>

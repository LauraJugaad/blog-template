---
import '../styles/global.css';
import SearchIsland from '~/components/SearchIsland.tsx';
import { env } from '~/lib/runtime-env';
import { getSiteConfig } from '~/lib/site';
import { organizationJsonLd, websiteJsonLd } from '~/lib/structured-data';
import { url } from '~/lib/paths';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  articleSection?: string;
  articleTags?: string[];
  articleAuthor?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
  articleSection,
  articleTags,
  articleAuthor,
} = Astro.props;

const site = getSiteConfig(env);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.siteUrl).toString();

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

// og:image fallback — no artigo, always emit something (hero or logo) so OG never silent.
const effectiveOgImage = ogImage ?? (ogType === 'article' ? site.defaultHeroImageUrl : undefined);

// Site-wide JSON-LD: Organization + WebSite (with SearchAction).
const baseJsonLd = [organizationJsonLd(site.org), websiteJsonLd(site)];
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allJsonLd = [...baseJsonLd, ...pageJsonLd];
---

<!doctype html>
<html lang={site.siteLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robotsContent} />
    {articleTags && articleTags.length > 0 && (
      <meta name="keywords" content={articleTags.join(', ')} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={site.siteLang.replace('-', '_')} />
    <meta property="og:site_name" content={site.siteName} />
    {effectiveOgImage && <meta property="og:image" content={effectiveOgImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}
    {articleTags && articleTags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content={effectiveOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {effectiveOgImage && <meta name="twitter:image" content={effectiveOgImage} />}

    <link rel="sitemap" href={url('/sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.siteName} href={url('/feed.xml')} />

    <!-- JSON-LD structured data -->
    {
      allJsonLd.map((data) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(data)}
        />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground">
    <a href="#main-content" class="skip-link">Pular para o conteúdo</a>

    <header class="sticky top-0 z-50 border-b border-border-hairline bg-background">
      <div class="mx-auto flex h-16 max-w-[var(--layout-max)] items-center gap-5 px-4 sm:px-6">
        <a
          href={url('/')}
          class="font-display text-2xl font-bold leading-none text-foreground no-underline hover:no-underline"
          aria-label={`${site.siteName} — início`}
        >
          {site.siteName}
        </a>

        <div class="hidden w-full max-w-sm md:block">
          <SearchIsland client:load />
        </div>

        <div class="flex-1"></div>

        <nav aria-label="Principal" class="text-sm">
          <ul class="flex items-center gap-4">
            <li class="hidden sm:block">
              <a href={url('/')} class="text-muted no-underline hover:text-foreground hover:no-underline">
                Início
              </a>
            </li>
            <li>
              <a
                href={url('/llms.txt')}
                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-muted no-underline hover:bg-surface-muted hover:text-foreground hover:no-underline"
                aria-label="Abrir llms.txt"
                title="llms.txt"
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 19.5V4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5Z" />
                  <path d="M8 7h8" />
                  <path d="M8 11h8" />
                  <path d="M8 15h5" />
                </svg>
              </a>
            </li>
            <li>
              <a
                href={site.org.url}
                class="inline-flex h-9 items-center rounded-full bg-foreground px-4 text-sm font-medium text-background no-underline hover:bg-primary-muted hover:no-underline"
              >
                Newsletter
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-border-hairline bg-surface-muted">
      <div class="mx-auto grid max-w-[var(--layout-max)] gap-8 px-4 py-10 text-sm text-muted sm:px-6 md:grid-cols-[1.2fr_1fr_1fr_1fr]">
        <div>
          <p class="mb-2 font-display text-2xl font-bold text-foreground">{site.siteName}</p>
          <p class="max-w-sm leading-6">{site.siteDescription}</p>
        </div>
        <nav aria-label="Explorar" class="space-y-2">
          <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-foreground">
            Explorar
          </p>
          <a href={url('/')} class="block no-underline hover:text-foreground hover:no-underline">Início</a>
          <a href={url('/sitemap.xml')} class="block no-underline hover:text-foreground hover:no-underline">Sitemap</a>
          <a href={url('/llms.txt')} class="block no-underline hover:text-foreground hover:no-underline">llms.txt</a>
        </nav>
        <nav aria-label="Institucional" class="space-y-2">
          <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-foreground">
            Institucional
          </p>
          <a href={site.org.url} class="block no-underline hover:text-foreground hover:no-underline">Site principal</a>
          <a href={`${site.org.url}/sobre`} class="block no-underline hover:text-foreground hover:no-underline">Sobre</a>
          <a href={`${site.org.url}/contato`} class="block no-underline hover:text-foreground hover:no-underline">Contato</a>
        </nav>
        <div class="space-y-2">
          <p class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-foreground">
            Atualizações
          </p>
          <a
            href={site.org.url}
            class="inline-flex h-9 items-center rounded-full bg-foreground px-4 font-medium text-background no-underline hover:bg-primary-muted hover:no-underline"
          >
            Receber newsletter
          </a>
          <p>&copy; {new Date().getFullYear()} {site.siteName}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
